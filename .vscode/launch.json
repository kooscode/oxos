{
    "version": "0.2.0",
    "configurations": [
        {
            // F5: build the debug kernel, start xemu paused, attach, run to the first breakpoint in the kernel.
            // Needs the C/C++ extension (ms-vscode.cpptools) and gdb-multiarch. nxdk apps: tools/vscode/.
            "name": "OXOS kernel: debug in xemu",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/kernel/build/debug/xboxkrnl.elf",
            "cwd": "${workspaceFolder}/kernel",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerServerAddress": "localhost:1234",
            "stopAtEntry": false,
            "setupCommands": [
                {"text": "set confirm off"},
                {"text": "-enable-pretty-printing", "ignoreFailures": true}
            ],
            "preLaunchTask": "oxos: start debug kernel",
            "postDebugTask": "oxos: stop debug kernel"
        }
    ]
}
