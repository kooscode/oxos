# Copyrighted inputs: never commit (BIOS/MCPX dumps, HDD images, Microsoft kernel binaries, game discs).
# Put them in xbox_files/ (see README.md) and game disc images in xiso/.
xbox_files/
xiso/
# xemu's persistent hard-disk copies and EEPROMs for make run and the other run targets
xemu_state/
# Local notes, ideas and discussions for future work (never committed)
experimental/
xboxkrnl.exe
*.bin
*.qcow2
*.cab
*.iso
*.bundle

# Build output
kernel/build*/
# Fetched by the build, except Intel's microcode and the game trainers, which are kept in the repo
# (third_party/intel_ucode/README.md, third_party/xbox_trainers/README.md)
third_party/*
!third_party/intel_ucode/
!third_party/xbox_trainers/
tests/*_test_title/bin/
tests/*_test_title/*.obj
tests/*_test_title/*.d
tests/*_test_title/*.exe
tests/*_test_title/*.pdb
tests/*_title/bin/
tests/*_title/*.obj
tests/*_title/*.d
tests/*_title/*.exe
tests/*_title/*.pdb
__pycache__/

# Local tool state
.claude/
claude-resume.sh
tools/xbe_launcher/bin/
tools/xbe_launcher/*.obj
tools/xbe_launcher/*.d
tools/xbe_launcher/*.exe
tools/xbe_launcher/*.pdb
tools/iso_launcher/bin/
tools/iso_launcher/*.obj
tools/iso_launcher/*.d
tools/iso_launcher/*.exe
tools/iso_launcher/*.pdb
tools/title_launcher/bin/
tools/title_launcher/*.obj
tools/title_launcher/*.d
tools/title_launcher/*.exe
tools/title_launcher/*.pdb
tools/ftp_server/bin/
