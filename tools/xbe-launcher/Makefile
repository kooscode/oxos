# XBE launcher (nxdk): started from a disc image that `make run-xbe` builds, it launches the XBE named in the disc's
# launch.txt, e.g. F:\apps\demo\default.xbe, the way a dashboard would. Built with nxdk (../../third_party/nxdk).
XBE_TITLE = OXOS\ XBE\ launcher
SRCS = $(CURDIR)/xbe_launcher.c
NXDK_DIR ?= $(CURDIR)/../../third_party/nxdk
include $(NXDK_DIR)/Makefile
